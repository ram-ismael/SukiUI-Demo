<suki:SukiWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:vm="using:SukiUI_Demo.ViewModels.Dialogs"
    x:Class="SukiUI_Demo.Views.Dialogs.ToolWindow"
    x:DataType="vm:ToolWindowModel"
    mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
    Title="ToolWindow"
    MinWidth="400"
    MinHeight="300"
    CanMaximize="False"
    CanResize="False"
    MaxHeightScreenRatio="{Binding MaxHeightScreenRatio}"
    MaxWidthScreenRatio="{Binding MaxWidthScreenRatio}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen">
    
    <Design.DataContext>
        <vm:ToolWindowModel Header="Design time" Message="Message in design time" />
    </Design.DataContext>
    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*,Auto">
        <suki:GlassCard Grid.Row="0" Margin="15">
            <suki:GroupBox Header="Window options">

                <Grid ColumnDefinitions="Auto,10,Auto,20,Auto,10,Auto" RowDefinitions="Auto,10,Auto,10,Auto">
                    <!-- Debug purposes
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Can resize:" />
                    <ToggleSwitch Grid.Row="0"
                                  Grid.Column="2"
                                  IsChecked="{Binding CanResize}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               VerticalAlignment="Center"
                               Text="Can maximize:" />
                    <ToggleSwitch Grid.Row="0"
                                  Grid.Column="6"
                                  IsChecked="{Binding CanMaximize}" />
                    -->

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Max width ratio:" />
                    <NumericUpDown Grid.Row="2"
                                   Grid.Column="2"
                                   Width="100"
                                   FormatString="F2"
                                   Increment="0.05"
                                   Maximum="5"
                                   Minimum="0"
                                   Value="{Binding MaxWidthScreenRatio}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="4"
                               VerticalAlignment="Center"
                               Text="Max height ratio:" />
                    <NumericUpDown Grid.Row="2"
                                   Grid.Column="6"
                                   Width="100"
                                   FormatString="F2"
                                   Increment="0.05"
                                   Maximum="5"
                                   Minimum="0"
                                   Value="{Binding MaxHeightScreenRatio}" />

                    <StackPanel Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="7"
                                Orientation="Horizontal"
                                Spacing="5">
                        <Button Click="CenterOnScreenButton_OnClick" Content="Center on screen" />
                        <!-- Debug purposes
                        <Button Click="ToggleAutoWindowSize_OnClick" Content="Toggle auto window size" />
                        <!-->
                    </StackPanel>
                </Grid>
            </suki:GroupBox>
        </suki:GlassCard>

        <suki:GlassCard Grid.Row="1" Margin="15,0,15,15">
            <suki:GroupBox Header="{Binding Header}">
                <ScrollViewer>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </ScrollViewer>
            </suki:GroupBox>
        </suki:GlassCard>

        <StackPanel Grid.Row="2"
                    Margin="15"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="10">
            <Button Classes="Flat"
                    Command="{Binding $parent[suki:SukiWindow].Close}"
                    Content="✓ Process" />
            <Button Classes="Flat"
                    Command="{Binding $parent[suki:SukiWindow].Close}"
                    Content="🗙 Close" />
        </StackPanel>
    </Grid>
</suki:SukiWindow>
