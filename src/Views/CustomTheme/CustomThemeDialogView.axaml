<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:vm="clr-namespace:SukiUI_Demo.ViewModels"
    x:DataType="vm:CustomThemeDialogViewModel"
    x:Class="SukiUI_Demo.Views.CustomThemeDialogView"
    mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <suki:GroupBox Header="Create Custom Theme">
        <StackPanel Spacing="20">
            <TextBox Text="{Binding DisplayName}" />
            <ColorPicker Color="{Binding PrimaryColor}" />
            <ColorPicker Color="{Binding AccentColor}" />
            <Button Command="{Binding TryCreateThemeCommand}" Content="Create" />
        </StackPanel>
    </suki:GroupBox>
</UserControl>
