<suki:SukiWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:SukiUI_Demo.ViewModels"
    x:Class="SukiUI_Demo.Views.WindowView"
    x:DataType="vm:WindowViewModel"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    Icon="/src/Assets/avalonia-logo.ico"
    Title="SukiUI Demo"
    CanFullScreen="True"
    CanMinimize="True"
    CanMaximize="True"
    CanMove="True"
    CanPin="False"
    CanResize="True"        
    IsMenuVisible="True"
    IsTitleBarVisible="True"
    ShowBottomBorder="True"
    ShowTitlebarBackground="True">

    <suki:SukiWindow.Hosts>
        <suki:SukiToastHost Manager="{Binding ToastManager}" />
        <suki:SukiDialogHost Manager="{Binding DialogManager}" />
    </suki:SukiWindow.Hosts>

    <suki:SukiWindow.LogoContent>
        <Image Width="22" Height="22" VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Source="/src/Assets/avalonia-logo.ico" />
    </suki:SukiWindow.LogoContent>

    <suki:SukiWindow.RightWindowTitleBarControls>
        <Button Classes="WindowControlsButton" Command="{Binding ToggleThemeCommand}">
            <materialIcons:MaterialIcon Width="16" Height="16"
                Foreground="{DynamicResource SukiText}"
                Kind="{Binding ThemeIcon}" />
        </Button>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <suki:SukiWindow.MenuItems>
        <!--
        <MenuItem Header="File">
            <MenuItem Command="{Binding ShowToastCommand}" Header="Test Notification" />
            <Separator />
            <MenuItem Command="{Binding ExitCommand}" Header="Exit" />
        </MenuItem>        
        <MenuItem Header="View">
            <MenuItem Command="{Binding ToggleThemeCommand}" Header="Toggle Theme" />
        </MenuItem>
        -->
        <MenuItem Header="Themes">
            <MenuItem Command="{Binding ToggleThemeCommand}" Header="Blue" />
            <MenuItem Command="{Binding ToggleThemeCommand}" Header="Green" />
            <MenuItem Command="{Binding ToggleThemeCommand}" Header="Orange" />
            <MenuItem Command="{Binding ToggleThemeCommand}" Header="Red" />
        </MenuItem>
        <MenuItem Header="Help">
            <MenuItem Header="Licence" />
            <MenuItem Header="About" />
        </MenuItem>
    </suki:SukiWindow.MenuItems>

    <suki:SukiSideMenu IsSearchEnabled="True"
                       ItemsSource="{Binding DemoPages}"
                       SelectedItem="{Binding ActivePage}">

        <suki:SukiSideMenu.ItemTemplate>
            <DataTemplate>
                <suki:SukiSideMenuItem Classes="Compact" Header="{Binding DisplayName}">
                    <suki:SukiSideMenuItem.Icon>
                        <materialIcons:MaterialIcon Kind="{Binding Icon}" />
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
            </DataTemplate>
        </suki:SukiSideMenu.ItemTemplate>

        <suki:SukiSideMenu.FooterContent>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Command" Value="{Binding OpenUrlCommand}" />
                    </Style>
                    <Style Selector="materialIcons|MaterialIcon">
                        <Setter Property="Width" Value="25" />
                        <Setter Property="Height" Value="25" />
                    </Style>
                </StackPanel.Styles>
                <Button Classes="Basic"
                        CommandParameter="https://github.com/kikipoulet/SukiUI"
                        ToolTip.Tip="Open On GitHub.">
                    <materialIcons:MaterialIcon Kind="Github" />
                </Button>
                <Button Classes="Basic"
                        CommandParameter="https://www.nuget.org/packages/SukiUI"
                        ToolTip.Tip="View On NuGet.">
                    <materialIcons:MaterialIcon Kind="Package" />
                </Button>
                <Button Classes="Basic"
                        CommandParameter="https://github.com/kikipoulet/CherylUI"
                        ToolTip.Tip="CheryUI - For Mobile">
                    <materialIcons:MaterialIcon Kind="Cat" />
                </Button>
            </StackPanel>
        </suki:SukiSideMenu.FooterContent>

    </suki:SukiSideMenu>

</suki:SukiWindow>