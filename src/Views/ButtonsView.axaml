<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:animations="clr-namespace:SukiUI.Animations;assembly=SukiUI"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:SukiUI_Demo.ViewModels"
    x:Class="SukiUI_Demo.Views.ButtonsView"
    x:DataType="vm:ButtonsViewModel"
    mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Styles>
        <Style Selector="WrapPanel.PageContainer > suki|GlassCard">
            <Setter Property="Width" Value="250" />
            <Setter Property="MinHeight" Value="120" />
            <Setter Property="Margin" Value="10" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Content" Value="Button" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="suki:ButtonExtensions.ShowProgress" Value="{Binding IsBusy}" />
         
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        </Style>
        <Style Selector="DropDownButton">
            <Setter Property="Content" Value="Button" />
            <Setter Property="suki:ButtonExtensions.ShowProgress" Value="{Binding IsBusy}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Flyout">
                <MenuFlyout>
                    <MenuItem Header="Item 1" />
                    <MenuItem Header="Item 2" />
                    <MenuItem Header="Item 3" />
                </MenuFlyout>
            </Setter>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" >
        <suki:GlassCard Classes="HeaderCard" >
            <suki:GroupBox  Header="Buttons">
                <StackPanel Classes="HeaderContent">
                    <TextBlock>
                        SukiUI has a handful of button styles, available in both the standard primary color, but also in the theme's accent color.
                    </TextBlock>
                    <TextBlock>
                        Clicking on any one of the buttons will make them all "Busy" for 3 seconds, and how this is achieved can be seen in the XAML for the Busy Button.
                    </TextBlock>
                    <StackPanel Margin="0,25,0,0" Orientation="Horizontal">
                        <TextBlock Margin="0,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="DemiBold"
                                   Text="Buttons Enabled: " />
                        <ToggleSwitch Margin="15,0,0,0"
                                      Classes="Switch"
                                      IsChecked="{Binding IsEnabled}" />

                    </StackPanel>
                </StackPanel>
            </suki:GroupBox>
        </suki:GlassCard>
        <ScrollViewer Grid.Row="1" Margin="20">
            <WrapPanel Classes="PageContainer">
                <suki:GlassCard animations:ErrorBehavior.IsActive="{Binding !IsEnabled}"
                                animations:ErrorBehavior.ErrorMessage="This is an error ! A longer message for testing purpose !">
                    <suki:GroupBox Header="Flat Button with icon">
                        <Button suki:ButtonExtensions.Icon="{materialIcons:MaterialIconExt Kind=Calendar}" Classes="Flat" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Flat Rounded Button">
                        <Button Classes="Rounded Flat" />
                    </suki:GroupBox>
                </suki:GlassCard>
                <suki:GlassCard animations:HoverBehavior.Scale="1.1" >
                    <suki:GroupBox Header="Standard Button">
                        <Button Click="Button_OnClick"  animations:VisibilityBehavior.IsVisible="{Binding IsEnabled}" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard animations:LoadingBehavior.IsBusy="{Binding !IsEnabled}">
                    <suki:GroupBox Header="Basic Button">
                        <Button Click="Button_OnClick" Classes="Basic" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard animations:DisabledBehavior.Opacity="0.1" animations:DisabledBehavior.Scale="0.9" IsEnabled="{Binding IsEnabled}">
                    <suki:GroupBox Header="Flat Button">
                        <Button Classes="Flat" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Outlined Button">
                        <Button Classes="Outlined" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Standard Accent Button">
                        <Button animations:GlowBehavior.IsActive="{Binding !IsEnabled}" Classes="Accent" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Basic Accent Button">
                        <Button Classes="Basic Accent" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Flat Accent Button">
                        <Button Classes="Flat Accent" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Flat Rounded Accent Button">
                        <Button Classes="Rounded Flat Accent" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Outlined Accent Button">
                        <Button Classes="Outlined Accent" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Success Button">
                        <Button Classes="Success" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Success Rounded Button">
                        <Button Classes="Success Rounded" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Success Rounded Button">
                        <Button Classes="Success Rounded" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Information Button">
                        <Button Classes="Information" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Warning Button">
                        <Button Classes="Warning" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Danger Button">
                        <Button Classes="Danger" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Busy Button">
                        <Button suki:ButtonExtensions.ShowProgress="True" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Small Button">
                        <Button Classes="Flat Small" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Small Action Button">
                        <Button Classes="Warning Small" Content="{materialIcons:MaterialIconExt Kind=Warning}" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Large Button">
                        <Button Classes="Flat Large" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Standard Icon Button">
                        <Button Classes="Icon" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Basic Icon Button">
                        <Button Classes="Basic Icon" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Flat Icon Button">
                        <Button Classes="Flat Icon" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Outlined Icon Button">
                        <Button Classes="Outlined Icon" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Basic Accent Icon Button">
                        <Button Classes="Basic Accent Icon" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Flat Accent Icon Button">
                        <Button Classes="Flat Accent Icon" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Outlined Accent Icon Button">
                        <Button Classes="Outlined Accent Icon" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="DropDownButton">
                        <DropDownButton />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Flat DropDownButton">
                        <DropDownButton Classes="Flat" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Flat DropDownButton">
                        <DropDownButton Classes="Flat Accent" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Success DropDownButton">
                        <DropDownButton Classes="Success" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Information DropDownButton">
                        <DropDownButton Classes="Information" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Warning DropDownButton">
                        <DropDownButton Classes="Warning" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Danger DropDownButton">
                        <DropDownButton Classes="Danger" />
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard>
                    <suki:GroupBox Header="Flat Icon DropDownButton">
                        <DropDownButton suki:ButtonExtensions.Icon="{materialIcons:MaterialIconExt Kind=Cog}" Classes="Flat" />
                    </suki:GroupBox>
                </suki:GlassCard>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>